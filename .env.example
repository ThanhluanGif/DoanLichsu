DATABASE_PATH=./data/quan-su-viet.db
APP_VERSION=0.1.0
APP_ORIGIN=http://localhost:3000
# Generate at least 32 random characters; never commit a real production secret.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# Optional demo accounts. Production seeding still requires ALLOW_DEMO_SEED=1.
SEED_ADMIN_PASSWORD=Admin-Demo-2026!
SEED_EDITOR_PASSWORD=Editor-Demo-2026!
SEED_REVIEWER_PASSWORD=Reviewer-Demo-2026!
