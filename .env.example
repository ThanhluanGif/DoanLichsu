DATABASE_PATH=./data/quan-su-viet.db
APP_VERSION=0.1.0
APP_ORIGIN=http://localhost:3000
# Generate at least 32 random characters; never commit a real production secret.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# Docker/HTTPS release settings. Keep the release port bound to loopback; terminate HTTPS at the proxy/tunnel.
RELEASE_PORT=3002
BACKUP_DIR=./backups
# RESTORE_DATABASE_PATH=/absolute/path/to/new-restored.db
# E2E_BASE_URL=https://release.example.com
# Local seed has documented demo defaults. Production seeding requires ALLOW_DEMO_SEED=1
# and all three explicit, non-demo passwords of at least 16 characters:
# SEED_ADMIN_PASSWORD=<generate-a-unique-secret>
# SEED_EDITOR_PASSWORD=<generate-a-unique-secret>
# SEED_REVIEWER_PASSWORD=<generate-a-unique-secret>
