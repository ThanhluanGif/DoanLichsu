{
  "name": "quan-su-viet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"const fs=require('node:fs'); fs.cpSync('.next/static', '.next/standalone/.next/static', { recursive: true }); fs.cpSync('public', '.next/standalone/public', { recursive: true })\" && esbuild scripts/seed.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=.next/standalone/scripts/seed.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "node scripts/contract-check.mjs",
    "test:public-ui:axe": "node tests/public-ui/axe-runtime.mjs",
    "test:e2e": "playwright test",
    "test:security": "vitest run tests/security",
    "security:review-pack": "node scripts/security-review-pack.mjs",
    "test:recovery": "vitest run tests/recovery",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "curriculum:coverage": "node scripts/curriculum-coverage.mjs",
    "live:smoke": "node scripts/live-smoke.mjs",
    "governance:check": "node scripts/governance-check.mjs",
    "rights:check": "node scripts/rights-check.mjs",
    "wikimedia:import": "node scripts/wikimedia-import.mjs",
    "media:rights": "node scripts/media-rights-check.mjs",
    "corpus:snapshot": "node scripts/approved-corpus.mjs",
    "ai:gateway": "node scripts/ai-gateway.mjs",
    "ai:eval": "node scripts/ai-eval.mjs",
    "ai:eval:dataset": "node scripts/ai-eval-dataset.mjs",
    "ai:tutor": "node scripts/ai-tutor.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "teacher:pack": "node scripts/teacher-pack.mjs",
    "university:dossier": "node scripts/university-dossier.mjs",
    "corrections:inbox": "node scripts/correction-inbox.mjs",
    "analytics:privacy": "node scripts/privacy-analytics.mjs",
    "offline:pack": "node scripts/offline-pack.mjs",
    "production:readiness": "node scripts/production-readiness.mjs",
    "transparency:dashboard": "node scripts/transparency-dashboard.mjs",
    "graph:export": "node scripts/knowledge-graph.mjs",
    "operations:check": "node scripts/operations-check.mjs",
    "operations:uptime": "node scripts/uptime-probe.mjs",
    "operations:evidence:verify": "node scripts/external-evidence-verify.mjs",
    "operations:evidence:intake": "node scripts/external-evidence-intake.mjs",
    "operations:performance": "node scripts/performance-probe.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:evidence:current": "node scripts/release-evidence-current.mjs",
    "verify:standalone": "node -e \"const f=require('node:fs'); for (const p of ['.next/standalone/server.js','.next/standalone/.next/static','.next/standalone/public/images/hero-history.webp','.next/standalone/public/images/hero-history-mobile.webp','.next/standalone/scripts/migrate.mjs','.next/standalone/scripts/seed.mjs','.next/standalone/src/lib/db/migration-engine.mjs','.next/standalone/migrations/0001_foundation.sql','.next/standalone/migrations/0002_public_content.sql','.next/standalone/migrations/0003_editorial_security.sql','.next/standalone/migrations/0004_source_governance.sql','.next/standalone/migrations/0005_curriculum.sql','.next/standalone/migrations/0006_lessons.sql','.next/standalone/migrations/0007_asset_provenance.sql']) { if (!f.existsSync(p)) throw new Error('Missing standalone artifact: '+p) }\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/three": "^0.180.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "iron-session": "^8.0.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
